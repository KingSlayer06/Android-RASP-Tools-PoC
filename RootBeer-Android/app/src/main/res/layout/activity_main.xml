<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RootBeer 0.1.2: pick checks to run"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/presetDefault" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="isRooted" android:textSize="12sp" />
            <Button android:id="@+id/presetBusyBox" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="+BusyBox" android:textSize="12sp" />
            <Button android:id="@+id/presetAll" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="All" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checkList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/extraApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Extra root-app package names (comma separated)"
            android:inputType="text" />

        <Button
            android:id="@+id/run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run selected checks" />

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
